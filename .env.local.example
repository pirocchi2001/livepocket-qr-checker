# Firebase コンソール > プロジェクトの設定 > 全般 > マイアプリ(Web) から取得
# NEXT_PUBLIC_ プレフィックスが付いた値はビルド時に静的ファイルへ埋め込まれます。
# (Firebaseのクライアント設定値は公開情報として扱われる前提のものです。
#  実際のアクセス制御は Firestore Security Rules 側で行ってください)

NEXT_PUBLIC_FIREBASE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:xxxxxxxxxxxxxxxxxxxxxx

# GitHub Pagesのプロジェクトページ用サブパス (例: リポジトリ名が livepocket-qr-checker なら)
NEXT_PUBLIC_BASE_PATH=/livepocket-qr-checker
