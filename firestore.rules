rules_version = '2';

// 前提: このアプリはFirebase Authenticationによるログインを行わない(匿名・全端末共通)構成。
// そのため「誰でも書き込める」代わりに、書き込める内容を極限まで制限することで安全性を担保する。
//
// 許可すること:
//   - 特定ハッシュ値のドキュメントを「新規作成のみ」可能 (=最初に読んだ端末が勝つ)
//   - 作成時のフィールドは scannedAt (サーバー生成タイムスタンプ) と
//     rawText (QRコードの中身、2000文字まで) のみ許可
//   - 既存ドキュメントの取得(get)は許可 (重複判定・初回日時表示のため)
//
// 禁止すること:
//   - 一覧取得(list) : 認証なしの場合は直近300件までに制限(全件抜き取りを防ぐため)
//   - 更新(update) / 削除(delete) : 一度記録された「読み取り済み」は覆せない
//   - scannedAt/rawText以外のフィールド追加、任意時刻での偽装(サーバー時刻と不一致な値)
service cloud.firestore {
  match /databases/{database}/documents {
    match /scans/{hash} {
      allow get: if true;
      // 一覧取得(list): 管理画面(認証済み)は無制限。
      // PC画面のスキャンログ表示など認証なしのアクセスは、
      // 1回のクエリで最大300件までに制限し、全件を一気に抜き取れないようにする。
      allow list: if request.auth != null
                  || (request.query.limit != null && request.query.limit <= 300);

      allow create: if request.resource.data.keys().hasOnly(['scannedAt', 'rawText'])
                    && request.resource.data.scannedAt == request.time
                    && request.resource.data.rawText is string
                    && request.resource.data.rawText.size() <= 2000;

      allow update: if false;
      allow delete: if false;
    }

    // 通過人数(全端末合計)の集計用ドキュメント。
    // 一覧取得(list)を使わずに件数だけ公開できるよう、単一ドキュメントに分離している。
    // 事前にFirebaseコンソール等で { totalCount: 0 } のドキュメントを
    // 手動作成しておく必要がある(公開create不可のため)。
    match /meta/counter {
      allow get: if true;
      allow list: if false;
      // 1回のスキャン成功につき+1のみ許可。他フィールドの追加や、
      // 1より大きい増分・減少・任意値への書き換えは拒否する。
      allow update: if request.resource.data.keys().hasOnly(['totalCount'])
                    && request.resource.data.totalCount == resource.data.totalCount + 1;
      allow create, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
